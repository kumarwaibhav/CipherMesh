# Required in production (CIPHERMESH_ENV=production refuses to start without it). >= 32 random chars.
CIPHERMESH_VAULT_SEED=
# Required in production
CIPHERMESH_VAULT_SALT=ciphermesh-deployment-salt
# Comma-separated retired seeds kept readable during key rotation
CIPHERMESH_VAULT_PREVIOUS_SEEDS=
CIPHERMESH_VAULT_ITERATIONS=600000
CIPHERMESH_ENV=development
# Optional: require X-CipherMesh-Token on POST /inspect
CIPHERMESH_API_TOKEN=
# Reviewer credential (X-CipherMesh-Reviewer-Token) for GET /reviews and review decisions.
# Production without it disables the review console (403). Development without it leaves it open.
CIPHERMESH_REVIEW_TOKEN=
CIPHERMESH_CORS_ORIGINS=*
CIPHERMESH_RATE_LIMIT_PER_MIN=120
CIPHERMESH_MAX_BODY_BYTES=400000
CIPHERMESH_REVIEW_TTL_S=900
CIPHERMESH_LATENCY_SCALE=0.02
CIPHERMESH_AUDIT_PATH=:memory:
